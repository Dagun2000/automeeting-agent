OPENAI_API_KEY=

# 스펙 5.1: 전 노드 일단 GPT-5.6 Luna로 통일. 특정 노드에서 품질 문제가 확인되면
# 해당 환경변수만 gpt-5.6-terra 등으로 개별 상향하세요.
MINUTES_MODEL=gpt-5.6-luna
IDEA_SELECT_MODEL=gpt-5.6-luna
SPEC_WORKER_MODEL=gpt-5.6-luna
SPEC_VALIDATOR_MODEL=gpt-5.6-luna
CLASSIFIER_MODEL=gpt-5.6-luna
STYLE_PLANNER_MODEL=gpt-5.6-luna
SETTING_DOC_WORKER_MODEL=gpt-5.6-luna
SETTING_DOC_VALIDATOR_MODEL=gpt-5.6-luna
REFERENCE_REPORT_WORKER_MODEL=gpt-5.6-luna
REFERENCE_REPORT_VALIDATOR_MODEL=gpt-5.6-luna
# 5.1 원안은 이미지 Validator만 Terra(vision)였으나, 9번 지시대로 지금은 Luna로 통일.
IMAGE_VALIDATOR_MODEL=gpt-5.6-luna

# 4.8: Worker-Validator critique 재시도 루프 한도 (retry_count < MAX_RETRIES까지 재시도).
# 기획서/설정집/비교대상 검색 보고서/이미지(개별) 트랙이 전부 이 값을 공유합니다.
MAX_RETRIES=2

# GPT-5.6 계열은 reasoning 모델이라 기본 reasoning_effort(medium)로는 구조화
# 출력/tool 바인딩("함수 도구")을 /v1/chat/completions에서 쓸 수 없습니다
# (실제 API 에러로 확인). src/llm.py가 전 노드에 공통 적용합니다.
REASONING_EFFORT=none

# 이미지 생성 모델. 스펙 5.2 원안은 DALL-E 3였으나 API에서 폐지되어(실제 API
# 에러로 확인) GPT 이미지 모델로 대체했습니다. 이 모델군은 URL이 아니라
# base64만 반환하므로 src/nodes/image.py가 자동으로 data URI로 변환합니다.
# gpt-image-2가 gpt-image-1보다 최신인데 더 저렴해서(공식 가격표 기준: image
# input $8 vs $10, output $30 vs $40 / 1M) 기본값으로 선택했습니다.
IMAGE_MODEL=gpt-image-2

# 비교대상 검색 보고서용 웹 검색은 ddgs 패키지(src/tools.py,
# backend="duckduckgo,brave,google,startpage")를 사용합니다 - API 키가
# 필요 없어 여기 설정할 항목이 없습니다(원래 Tavily API 키를 썼으나 rate
# limit 문제로 교체함; ddgs 기본값("auto")은 느리고, 단일 백엔드는 폴백이
# 없어 실측 결과 연속 검색 몇 번만에 막혀서 여러 엔진을 폴백 목록으로
# 명시함 - src/tools.py 모듈 docstring 참고).

# RAG(5.2, src/rag.py) - 사내 코퍼스(용어집/게임 프로필) 임베딩/검색 설정.
RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG Retrieval 노드가 트랜스크립트당 검색해오는 최대 문서 개수.
RAG_TOP_K=10
# 코사인 관련도 점수 컷오프 - 이 밑으로는 상위 RAG_TOP_K 안에 들어도
# 버린다. 예전엔 0.0(사실상 필터링 없음)이었는데, 코퍼스와 완전히 무관한
# 회의록으로 실측해보니 24개 문서 중 18개가 0.0 이상으로 통과해 노이즈가
# RAG_TOP_K만큼 그대로 채워졌다(최고 노이즈 점수 0.2542). 반면 진짜 언급된
# 용어는 0.3 이상에서도 잡히는 경우가 많아 0.3으로 올림 - 그 밑으로
# 떨어지는 약한 매치(짧은 고유명사 등)는 아래 표면형(fuzzy) 매칭이
# 전담한다. src/rag.py의 SCORE_THRESHOLD 주석 참고.
RAG_SCORE_THRESHOLD=0.3
# 표면형(오탈자) 매칭 컷오프(difflib ratio, 0~1) - 의미 검색이 놓치는 짧은
# 고유명사 오탈자(예: "크림즌 프로토콜"↔"크림슨 프로토콜")를 보완한다.
RAG_FUZZY_MIN_RATIO=0.72

# STT(src/stt.py) - 앱 기본 화면(녹음 버튼)에서 사용. Diarization(화자 분리)은
# 구현하지 않음(src/stt.py 모듈 docstring 참고 - 현재 태깅 로직이 화자
# 정보를 쓰지 않아서 실익 대비 구현 비용이 크다고 판단함).
STT_MODEL=whisper-1
# 회의가 전부 한국어라 언어 자동 감지에 맡기지 않고 고정한다(ISO-639-1).
STT_LANGUAGE=ko
